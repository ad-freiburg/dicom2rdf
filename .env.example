# Path to DICOM SR documents. Supported file extensions:
# - .dcm
# - .tar.zst archive containing single .dcm file
INPUT=/path/to/dicom-sr-documents

# Number of triples per intermediate chunk file. Workers rotate files at this
# interval. Smaller values create more intermediate files but enable finer-grained
# merging.
CHUNK_SIZE=10000000

# Maximum triples per final output file. Must be a multiple of CHUNK_SIZE.
# Intermediate files are merged to create files up to this size.
MAX_TRIPLES_PER_FILE=1000000000

# Gzip compression level (0-9). Lower values are faster, higher values produce
# smaller files.
COMPRESSION_LEVEL=1

# UID and GID under which the user inside the QLever container runs. It is
# advised that you set these to `id -u` and `id -g`, respectively.
UID=1000
GID=1000

# QLever ports
QLEVER_PORT=7055
QLEVER_UI_PORT=8176

# Benchmarking
# NUM_THREADS=1
